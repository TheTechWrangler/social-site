# ─── Social Site Environment Variables ───
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ─── Environment ───
NODE_ENV=development

# ─── Server ───
PORT=3003

# ─── Storage ───
# Relative paths are resolved from the repository root.
# Development defaults (when these are blank): data/dev-social.db and uploads-dev/
# Production defaults: data/social.db and uploads/ (only with NODE_ENV=production)
# Tests must supply both values explicitly; the isolated smoke harness does this.
DATABASE_PATH=
UPLOADS_DIR=

# Backend base URL (used for OAuth callback defaults, session origin checks).
# Development:
APP_BASE_URL=http://localhost:3003
# Production:
# APP_BASE_URL=https://refugecloud.com

# Frontend base URL (used for CORS, post-OAuth redirect).
# Development:
WEB_BASE_URL=http://localhost:5174
# Production:
# WEB_BASE_URL=https://refugecloud.com

# ─── Security (REQUIRED in production) ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# ─── Reverse Proxy ───
# Set to 1 when running behind Nginx Proxy Manager (or any single reverse proxy).
# Required for rate limiting to see real client IPs instead of the proxy IP.
TRUST_PROXY=0

# ─── Google OAuth 2.0 (optional) ───
# Docs: https://console.cloud.google.com/apis/credentials
# Application type: Web application
#
# Production values to register in Google Cloud Console:
#   Authorized JavaScript origins: https://refugecloud.com
#   Authorized redirect URI:       https://refugecloud.com/api/auth/google/callback
#
# Development:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3003/api/auth/google/callback
# Production (set these in your production .env):
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-<your-secret>
# GOOGLE_CALLBACK_URL=https://refugecloud.com/api/auth/google/callback

# ─── Steam OpenID (optional) ───
# Docs: https://steamcommunity.com/dev/apikey
#
# Production values to register at Steam:
#   Domain: refugecloud.com
#   Return URL (realm): https://refugecloud.com/
#   Return URL (callback): https://refugecloud.com/api/auth/steam/callback
#
# Development:
STEAM_API_KEY=
STEAM_RETURN_URL=http://localhost:3003/api/auth/steam/callback
STEAM_REALM=http://localhost:3003
# Production (set these in your production .env):
# STEAM_API_KEY=<your-32-char-api-key>
# STEAM_RETURN_URL=https://refugecloud.com/api/auth/steam/callback
# STEAM_REALM=https://refugecloud.com/

# ─── Transactional Email — Resend (optional but required for email verification) ───
# Docs: https://resend.com/docs/introduction
# Sign up at https://resend.com, verify your domain, create an API key.
#
# EMAIL_PROVIDER is informational only — the code always uses Resend.
# If RESEND_API_KEY is missing, email sending is disabled gracefully:
#   - Registration still works; users are created unverified.
#   - A warning is logged at startup.
#   - Verification emails are silently skipped (no crash).
#
EMAIL_PROVIDER=resend
EMAIL_FROM=RefugeCloud <noreply@refugecloud.com>
RESEND_API_KEY=
# Production:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=RefugeCloud <noreply@refugecloud.com>

# Verification token expiry in hours (default: 24).
EMAIL_VERIFICATION_TTL_HOURS=24

# Retention for expired verification tokens (default: 7 days).
EMAIL_VERIFICATION_TOKENS_RETENTION_DAYS=7

# Self-serve password reset token expiry in hours (default: 1).
# Admin-generated tokens are always 2 hours (set in admin route).
PASSWORD_RESET_TTL_HOURS=1

# Max self-serve password reset requests per IP per 15-minute window (default: 5).
RATE_LIMIT_FORGOT_PASSWORD_MAX=5

# Max resend-verification requests per IP per 15-minute window (default: 3).
RATE_LIMIT_RESEND_VERIFICATION_MAX=3

# ─── LAN Testing (uncomment to use LAN IP instead of localhost) ───
# APP_BASE_URL=http://192.168.254.181:3003
# WEB_BASE_URL=http://192.168.254.181:5174
# GOOGLE_CALLBACK_URL=http://192.168.254.181:3003/api/auth/google/callback
# STEAM_RETURN_URL=http://192.168.254.181:3003/api/auth/steam/callback
# STEAM_REALM=http://192.168.254.181:3003

# ─── Media Uploads ───
ENABLE_IMAGE_UPLOADS=true
ENABLE_EXTERNAL_VIDEO_EMBEDS=true
ENABLE_VIDEO_UPLOADS=false

# Upload limits (MB)
MAX_IMAGE_UPLOAD_MB=5
MAX_AVATAR_UPLOAD_MB=2
MAX_VIDEO_UPLOAD_MB=250

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_WINDOW_MINUTES=15
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_FEED_MAX=120
RATE_LIMIT_USER_SEARCH_MAX=60
RATE_LIMIT_POLLING_MAX=600
RATE_LIMIT_USAGE_MAX=120
